{
  "name": "relay-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:cli",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run build:cli",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test \"lib/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "agent": "tsx scripts/agent.ts",
    "relay": "tsx scripts/relay.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "org:setup": "tsx scripts/org-setup.ts",
    "org:seed": "tsx scripts/org-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "chain:setup": "tsx scripts/chain-setup.ts",
    "chain:artifacts": "cd contracts && forge build && node script/export-chain-artifacts.mjs"
  },
  "dependencies": {
    "@base-org/account": "2.5.13",
    "@metamask/connect-evm": "2.1.1",
    "@phala/dstack-sdk": "0.5.8",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.0",
    "@walletconnect/ethereum-provider": "2.25.0",
    "@worldcoin/idkit": "4.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@rainbow-me/rainbowkit": {
      "wagmi": "$wagmi"
    }
  }
}
